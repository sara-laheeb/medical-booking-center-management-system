# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
# Dedicated application user (e.g. booking_app) or administrator (root)
DB_USER=booking_app
DB_PASSWORD=your_database_password
DB_NAME=booking_db

# Authentication / Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Optional SMTP Email Configuration
# If omitted or unconfigured, the system runs safely in simulated log mode
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
# SMTP_FROM="Vita Medical Complex <noreply@vitamedical.local>"
